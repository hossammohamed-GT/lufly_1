.env
/storage/logs/*
/storage/cache/*
/storage/uploads/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/uploads/.gitkeep
.DS_Store
Thumbs.db
/storage/backups/*
!/storage/backups/.gitkeep
/storage/reports/*
!/storage/reports/.gitkeep
.vercel
.env*

# photos visitors send the finder: they belong to the shop, not to git
/public/uploads/assistant/*
!/public/uploads/assistant/.gitkeep

# Python bytecode from the import tooling
__pycache__/
*.py[cod]

# tooling installs (php-wasm, one-shot dev deps)
node_modules/

# Runtime database artifacts. Keep the tracked local SQLite runtime and the
# canonical /lufly-database.sql server import; ignore other generated copies.
/database/*.sqlite
!/database/lufly.sqlite
/database/*.sqlite3
/database/*.db
/database/sql/
/database/schema/*.sql
/public/manage_products_lufly_new/

