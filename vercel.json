{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "config/**,core/**,app/**,modules/**,database/**,resources/**,storage/**,bootstrap.php"
    }
  },
  "routes": [
    {
      "src": "/(images|frontend)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://lufly-platform.vercel.app",
    "DB_CONNECTION": "sqlite",
    "LOG_CHANNEL": "stderr"
  }
}
