APP_NAME="Lufly Platform"
APP_ENV=local
APP_KEY=base64:0HqWdxBFQdH+vydgujjGEac2fa/4w41DvnqkabFviSk=
APP_DEBUG=true
APP_URL=http://localhost/lufly_1/
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# DATABASE — MySQL (production / XAMPP)
# 1) Import lufly-database.sql once (phpMyAdmin > Import). It creates the
#    "lufly" database, all tables and all data — full from-scratch import.
# 2) Then set DB_CONNECTION=mysql in your local .env (default: sqlite).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lufly
DB_USERNAME=root
DB_PASSWORD=

# --- Alternative: SQLite (zero-config dev fallback) --------------------------
# Switch DB_CONNECTION to "sqlite" and the app runs on database/lufly.sqlite.
# DB_CONNECTION=sqlite
# DB_SQLITE_PATH=database/lufly.sqlite

LOG_LEVEL=debug
LOG_CHANNEL=app

CACHE_DRIVER=file
SESSION_LIFETIME=7200

# ---------------------------------------------------------------------------
# MAIL — outgoing mail (the saved-list e-mail, contact forms, notifications)
# transport: log  = nothing leaves the server, the full message is written to
#                  storage/logs/mail.log (handy while setting things up)
#            mail = PHP mail(), i.e. the MTA of a XAMPP / cPanel account
#            smtp = authenticated SMTP, recommended for info@lufly.tr
# With smtp: host is your mail server, 587 goes with encryption=tls (STARTTLS)
# and 465 with encryption=ssl. The password is the mailbox password.
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=log
MAIL_HOST=mail.lufly.tr
MAIL_PORT=587
MAIL_USERNAME=info@lufly.tr
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@lufly.tr
MAIL_FROM_NAME="LUFLY"
# Store inbox that receives a copy of every saved list
MAIL_ADMIN_ADDRESS=info@lufly.tr
# Replies to a visitor's copy land here too (defaults to MAIL_FROM_ADDRESS)
# MAIL_REPLY_TO=info@lufly.tr

# ---------------------------------------------------------------------------
# SAVED PRODUCTS ("favorites") — every visitor can keep a list of products and
# mail it to themselves. Set FEATURE_FAVORITES=false to hide the feature.
# ---------------------------------------------------------------------------
FEATURE_FAVORITES=true
FAVORITES_NOTIFY_ADMIN=true
FAVORITES_MAX_ITEMS=60
FAVORITES_EMAIL_COOLDOWN=60
FAVORITES_EMAIL_DAILY_LIMIT=5

# ---------------------------------------------------------------------------
# AI (Google Gemini) — used by the assistant and the bathroom planner.
#
# Five free AI Studio accounts are rotated: each key belongs to its own Google
# project, so the daily free quota multiplies instead of being shared. Leave a
# key empty to skip that slot; AI_MODEL_N overrides AI_MODEL for that account.
#
# The AI_KEY_* value is the whole key (it may start with "AQ." — that is the
# current format, and the app sends it in the x-goog-api-key header, which is
# the only auth route that format accepts).
#
# Comments may sit at the end of a line (`AI_MODEL=…   # note`) — the loader
# drops them — but a comment on its own line is always easier to read.
#
# Check everything after filling this in:  php cli ai:doctor --image
# ---------------------------------------------------------------------------
FEATURE_AI=true
AI_ENABLED=true

AI_KEY_1=
AI_KEY_2=
AI_KEY_3=
AI_KEY_4=
AI_KEY_5=

# one model for every key …
AI_MODEL=gemini-2.5-flash
# … or per account (empty = AI_MODEL), e.g. AI_MODEL_2=gemini-2.5-flash-lite
AI_MODEL_1=
AI_MODEL_2=
AI_MODEL_3=
AI_MODEL_4=
AI_MODEL_5=

# image model (Nano Banana) — draws the planned bathroom / edits a room photo.
# Image generation is the first thing a free tier withholds: if `ai:doctor
# --image` answers 429 while the text keys pass, the account has no picture
# quota. Set AI_IMAGE_MODEL= (empty) and the planner quietly hides its picture
# button — the plan, the drawing and the products are unaffected.
AI_IMAGE_MODEL=gemini-2.5-flash-image

# guard rails + shape
AI_DAILY_LIMIT_PER_IP=15
AI_TIMEOUT=45
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.4
AI_CACHE_HOURS=720
AI_LOG=true

# ---------------------------------------------------------------------------
# Bathroom planner — three taps → a sized plan, a scaled drawing and the
# matching LUFLY products. The plan and the drawing are computed locally (no
# tokens at all); only the welcome sentence and the optional picture call the
# assistant, and both are cached.
#
# NOTE: nothing to add to an existing database — the planner stores its cached
# plans in the ai_cache / ai_usage tables of migration 19.
# ---------------------------------------------------------------------------
FEATURE_PLANNER=true
PLANNER_ENABLED=true

# the assistant writes the wording (false = the built-in sentences only)
PLANNER_AI=true

# the chat floats in the corner of every page; PLANNER_CHAT=false keeps it on
# /planner only
PLANNER_CHAT=true

# "does this piece fit my plan?" on a product page — answered from the product's
# own text (name, description, category): no image, no catalogue sweep
PLANNER_FIT=true
PLANNER_FIT_DAILY=8

# the optional picture of the finished room (needs AI_IMAGE_MODEL above).
# PLANNER_RENDER_SOON=true announces it as "coming soon" instead of offering a
# button that the free image quota cannot answer; set it to false the day a
# billed image key is in AI_IMAGE_MODEL.
FEATURE_PLANNER_RENDER=true
PLANNER_RENDER=true
PLANNER_RENDER_SOON=true
PLANNER_RENDER_DAILY=3

# where a plan goes when the visitor asks us to source the pieces
PLANNER_HANDOFF_EMAIL=info@lufly.tr
PLANNER_WHATSAPP=908503040817
PLANNER_HANDOFF_PHONE="+90 850 3040 817"

# the planner is promised, not offered yet: the chat's second tab says "coming
# soon" and /planner answers with the same promise instead of the flow. Nothing
# is deleted — PLANNER_COMING_SOON=false puts the page back exactly as it was.
PLANNER_COMING_SOON=true

# how long a plan stays cached, and how many catalogue picks per item
PLANNER_CACHE_HOURS=720

# ---------------------------------------------------------------------------
# The finder (the chat in the corner of every page)
# ---------------------------------------------------------------------------
# The visitor writes what they are looking for — in any language — or sends a
# photo, and gets back the pieces from our own catalogue that match.
#
# The catalogue is never sent to the assistant. The words are matched against
# the products locally; the model is asked, only when the local pass found
# nothing good, to turn a sentence or a photo into a handful of search words.
# A question that costs nothing costs no tokens at all.
#
# NOTE: this one needs a table — migration 20 (`assistant_leads`). On a live
# MySQL database paste database/sql/2026_01_01_000020_assistant_mysql.sql.
# ---------------------------------------------------------------------------
FEATURE_AI=true
ASSISTANT_ENABLED=true
ASSISTANT_CHAT=true

# the assistant turns a description (or a photo) into search words.
# ASSISTANT_AI=false = the local word matching only, zero AI calls
ASSISTANT_AI=true
# reading a photo needs a key that can see; switch it off to save quota
ASSISTANT_VISION=true
# empty = the text model from AI_MODEL above
ASSISTANT_AI_MODEL=

# how the search answers: cards per answer, words kept from a sentence,
# and the score at which the local answer is good enough to skip the model
ASSISTANT_LIMIT=6
ASSISTANT_TERMS=8
ASSISTANT_GOOD_SCORE=24

# answers per visitor per day, and how much of their own words are kept
ASSISTANT_DAILY=20
ASSISTANT_MAX_CHARS=600

# the photo: the browser shrinks it first (longest side 1280 px)
ASSISTANT_PHOTO=true
ASSISTANT_PHOTO_KB=4096

# the mail the shop gets when somebody sends a photo or leaves an address.
# ASSISTANT_ASK_EMAIL=true asks for the address before the first answer (once,
# and the visitor may continue without it — the field is never a wall).
ASSISTANT_ASK_EMAIL=true
ASSISTANT_LEAD_MAIL=hossam545mohamed@gmail.com
# what the customers table stores when the visitor skipped the field
ASSISTANT_LEAD_DEFAULT=hossam545mohamed@gmail.com

# how long one answer is remembered (the wording may change, the catalogue not)
ASSISTANT_CACHE_HOURS=168

UPLOAD_DISK=local
UPLOAD_MAX_SIZE=10240

SECURITY_BCRYPT_COST=12
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_SECONDS=300
